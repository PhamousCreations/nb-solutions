# Copy this file to .env and fill in your own values.
# .env is gitignored — it will never be committed or deployed.
#
# The server does NOT read .env by itself (there are no dependencies).
# Load it with Node's built-in flag (Node 20.6+):
#
#     node --env-file=.env server.js
#
# Or just set variables in your shell, which works on every Node version:
#
#     ADMIN_KEY=my-secret node server.js
#
# On a hosting platform (Render, Railway, Fly) set these in their dashboard
# instead — you don't need this file there at all.

# Password for the staff dashboard at /admin.
# CHANGE THIS before going live. Use something long and random.
ADMIN_KEY=freshfold-admin

# Where booking data is stored.
# Leave blank locally (defaults to ./data).
# On a host with a persistent disk, point it at the mount path:
#   Render disk  -> /var/data
#   Docker       -> /data
# DATA_DIR=/var/data

# Port the server listens on. Hosts like Render set this automatically.
PORT=3000
